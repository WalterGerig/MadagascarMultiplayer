CompileFlags:
  Add:
    - "-std=c++20"
    - "-m32"
    - "-DWIN32_LEAN_AND_MEAN"
    - "-DNOMINMAX"
    - "-D_CRT_SECURE_NO_WARNINGS"
    - "-Iclient/include"
    - "-Iclient/vendor/imgui"
    - "-Iclient/vendor/d3d8"
    - "-Iloader/include"
    - "-Iloader/vendor"

Diagnostics:
  UnusedIncludes: None
